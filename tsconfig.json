{
  "compilerOptions": {
    "noEmit": true,
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "ES2015",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "config", "webpack.config.ts", "eslint.config.mts", "scripts"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
